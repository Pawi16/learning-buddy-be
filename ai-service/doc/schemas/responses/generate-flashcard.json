{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.learning-buddy.ai/schemas/responses/generate-flashcard.json",
  "title": "Generate Flashcard Response",
  "description": "Response containing generated flashcards for a topic",
  "type": "object",
  "properties": {
    "topic_title": {
      "type": "string",
      "minLength": 1,
      "description": "Title of the topic"
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "flashcard-item.json"
      },
      "description": "Generated flashcards",
      "minItems": 1
    }
  },
  "required": ["topic_title", "cards"],
  "additionalProperties": false
}
