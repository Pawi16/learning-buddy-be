{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.learning-buddy.ai/schemas/requests/generate-flashcard.json",
  "title": "Generate Flashcard Request",
  "description": "Request schema for generating flashcards from topic content",
  "type": "object",
  "properties": {
    "topicName": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the topic to generate flashcards for"
    },
    "topicContent": {
      "type": "string",
      "minLength": 1,
      "description": "Content/text about the topic"
    },
    "config": {
      "$ref": "flashcard-config.json"
    }
  },
  "required": ["topicName", "topicContent", "config"],
  "additionalProperties": false
}
