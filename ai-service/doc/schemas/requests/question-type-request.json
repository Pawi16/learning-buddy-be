{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.learning-buddy.ai/schemas/requests/question-type-request.json",
  "title": "Question Type Request",
  "description": "Specification for generating questions of a specific type",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["NORMAL_MULTIPLE", "STATEMENT_VERIFICATION", "STATEMENT_COUNTING"],
      "description": "Type of question to generate"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of questions to generate"
    }
  },
  "required": ["type", "number"],
  "additionalProperties": false
}
