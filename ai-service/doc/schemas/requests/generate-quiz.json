{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.learning-buddy.ai/schemas/requests/generate-quiz.json",
  "title": "Generate Quiz Request",
  "description": "Request schema for generating quiz questions based on a topic",
  "type": "object",
  "properties": {
    "topicName": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the topic to generate quiz for"
    },
    "topicContent": {
      "type": "string",
      "minLength": 1,
      "description": "Content/text about the topic"
    },
    "quiz_config": {
      "type": "array",
      "items": {
        "$ref": "quiz-config.json"
      },
      "description": "Quiz configuration array",
      "minItems": 1
    }
  },
  "required": ["topicName", "topicContent", "quiz_config"],
  "additionalProperties": false
}
